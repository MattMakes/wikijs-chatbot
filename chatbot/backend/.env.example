DB_USER=wikijs
DB_PASSWORD=your_db_password

# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Indexing Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
